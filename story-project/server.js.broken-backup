const storyContainer = document.getElementById("story");

const params = new URLSearchParams(window.location.search);
const storyId = params.get("id");


async function loadStory() {

    if (!storyId) {

        storyContainer.innerHTML = `
            <h1>Story not found</h1>
        `;

        return;
    }

    try {

        // Get story
        const response =
            await fetch(`/api/stories/${storyId}`);

        if (!response.ok) {
            throw new Error("Story not found");
        }

        const story =
            await response.json();


        // Check logged-in user
        const userResponse =
            await fetch("/api/me");

        const currentUser =
            await userResponse.json();


        let imageHTML = "";

        if (story.image) {

            imageHTML = `
                <div class="story-image-container">
                    <img
                        src="${escapeHTML(story.image)}"
                        alt="${escapeHTML(story.title)}"
                        class="story-image"
                    >
                </div>
            `;

        }


        let deleteButtonHTML = "";


        // Only show delete button to the owner
        if (
            currentUser.loggedIn &&
            story.user_id &&
            Number(story.user_id) === Number(currentUser.userId)
        ) {

            deleteButtonHTML = `
                <button
                    id="delete-story"
                    class="btn delete-btn"
                    type="button"
                >
                    Delete Story
                </button>
            `;

        }


        storyContainer.innerHTML = `

            <span class="category">
                ${escapeHTML(story.category)}
            </span>

            <h1>
                ${escapeHTML(story.title)}
            </h1>

            <p class="author">
                Written by
                ${escapeHTML(story.author)}
            </p>

            ${imageHTML}

            <hr>

            <div class="story-content">
                ${formatStory(story.content)}
            </div>

            <div class="story-actions">

                <a
                    href="index.html"
                    class="btn secondary"
                >
                    ← Back to Stories
                </a>

                ${deleteButtonHTML}

            </div>

        `;


        // Attach delete functionality
        const deleteButton =
            document.getElementById("delete-story");


        if (deleteButton) {

            deleteButton.addEventListener(
                "click",
                deleteStory
            );

        }


    } catch (error) {

        console.error(error);

        storyContainer.innerHTML = `
            <h1>Story not found</h1>

            <p>
                This story may have been removed.
            </p>

            <a
                href="index.html"
                class="btn secondary"
            >
                ← Back to Stories
            </a>
        `;

    }

}


async function deleteStory() {

    const confirmed =
        confirm(
            "Are you sure you want to delete this story?"
        );


    if (!confirmed) {
        return;
    }


    try {

        const response =
            await fetch(
                `/api/stories/${storyId}`,
                {
                    method: "DELETE"
                }
            );


        const data =
            await response.json();


        if (!response.ok) {

            alert(
                data.error ||
                "Unable to delete story."
            );

            return;
        }


        alert("Story deleted successfully.");


        window.location.href =
            "index.html";


    } catch (error) {

        console.error(error);

        alert(
            "Unable to delete story."
        );

    }

}


function escapeHTML(text) {

    const div =
        document.createElement("div");

    div.textContent = text;

    return div.innerHTML;

}


function formatStory(text) {

    return escapeHTML(text)
        .replace(/\n/g, "<br><br>");

}


loadStory();